# ==============================================================================
# Blaze Universe — Flagship Continuum, Gaming, Audio & Enterprise Fragment
# ==============================================================================

# --- Blaze Continuum (sched_ext eBPF scheduler + CRIU checkpoint/restore) -----
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_CHECKPOINT_RESTORE=y

# --- Gaming & Low-Latency Desktop (1000Hz, Full Preemption, NTSYNC, HID) ------
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NTSYNC=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y

# --- Audio, Webcam, Bluetooth & Enterprise Storage/Networking -----------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_TUN=y
CONFIG_BTRFS_FS=y
CONFIG_EXFAT_FS=y
