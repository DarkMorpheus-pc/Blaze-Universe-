# ==============================================================================
# Blaze Universe — kernel hardening fragment
# Merged on top of the base config by bootstrap/build-linux-7.2.9.sh.
# Sources: KSPP recommended settings (kspp.github.io), Fedora and Arch Linux
# distribution kernel configs. Options that would break desktop use
# (e.g. module signing enforcement, disabling unprivileged user namespaces
# needed by Flatpak/browser sandboxes) are intentionally left out.
# ==============================================================================

# --- LSM stack: actually build every LSM listed in CONFIG_LSM -------------------
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_LSM="landlock,lockdown,yama,apparmor"
CONFIG_SECURITY_DMESG_RESTRICT=y

# --- Memory safety ------------------------------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STACKPROTECTOR_STRONG=y

# --- Attack surface -----------------------------------------------------------
# TIOCSTI injection (CVE class) — disabled by Fedora/Arch since 6.2.
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# vsyscall emulation off (glibc does not need it).
CONFIG_LEGACY_VSYSCALL_NONE=y
# userfaultfd is needed by some apps; unprivileged use is blocked via sysctl.
CONFIG_USERFAULTFD=y

# --- Desktop correctness (consumers of BPF / cgroups in systemd) ----------------
CONFIG_CGROUP_BPF=y
