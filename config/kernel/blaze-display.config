# ==============================================================================
# Blaze Universe — early display / console fragment
# Captures settings that were previously hand-tuned in build #5 so that the
# graphical boot path is reproducible: virtio-gpu and KMS helpers built in
# (no initramfs module loading needed in VMs), simpledrm/efifb handover for
# real hardware, and a framebuffer text console for the recovery path.
# ==============================================================================
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_VIRTIO_DMA_SHARED_BUFFER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_BOOT_VESA_SUPPORT=y
